sources:
  hr_orthophoto_source:
    type: wms
    wms_opts:
      version: '1.3.0'
    req:
      url: https://geoportal.dgu.hr/services/auth/inspire/orthophoto_2025_2026/ows?authKey=YOUR_DGU_AUTH_KEY
      layers: OI.OrthoimageCoverage
      format: image/png
      transparent: true
    supported_srs: ['EPSG:3765']
    coverage:
      # DGU's own declared service extent (from GetCapabilities) -- keeps
      # requests for obviously-out-of-country tiles from ever reaching DGU,
      # while still allowing live/lazy fetches anywhere they might have data.
      bbox: [15.365352529039757, 42.332434825353964, 19.54991174229248, 46.56160452582029]
      srs: 'EPSG:4326'
